# denied_15.at - an LTE-M device in a REGISTRATION_DENIED loop, EMM cause #15.
#
# Format (read by tests/lc/test_lc.c):
#   # ...                 comment
#   @ <seconds>           uptime for the lines that follow
#   SYNTHETIC | <line>    an AT line written by hand, not captured from a modem
#   FROM-SPEC | <line>    an AT line whose values are a worked example in the spec
#   fw | band | battery   application setters (not AT)
#   expect-text | ...     exact record_encode_text() output after the file
#   expect-counts | ...   parser counters after the file
# No real capture exists yet, so every AT line here is SYNTHETIC. Syntax:
# 3GPP TS 27.007 V19.6.0; '%' lines: Murata Type 1SC AT Command Reference rev 1.1.
fw | 0.3.1
battery | 3610
band | 20
@ 0
SYNTHETIC | AT+CEREG=5
SYNTHETIC | OK
@ 12
SYNTHETIC | +CEREG: 2,"1A2B","01A2B3C",7
@ 14
SYNTHETIC | +CEREG: 3,"1A2B","01A2B3C",7,0,15
@ 300
SYNTHETIC | +CEREG: 2,"1A2B","01A2B3C",7
@ 302
SYNTHETIC | +CEREG: 3,"1A2B","01A2B3C",7,0,15
@ 1500
SYNTHETIC | +CEREG: 2,"1A2B","01A2B3C",7
@ 1502
SYNTHETIC | +CEREG: 3,"1A2B","01A2B3C",7,0,15
@ 15120
# A read while still denied: same cause, not a new attempt, no new stamp.
SYNTHETIC | AT+CEREG?
SYNTHETIC | +CEREG: 5,3,"1A2B","01A2B3C",7,0,15
SYNTHETIC | OK
# AcT-type 4 = WB-S1: refines the RAT from "E-UTRAN" to LTE-M.
SYNTHETIC | AT+CEDRXRDP
SYNTHETIC | +CEDRXRDP: 4,"0101","0010","0011"
SYNTHETIC | OK
SYNTHETIC | AT+CPSMS?
SYNTHETIC | +CPSMS: 1,,,"00100001","00100001"
SYNTHETIC | OK
# rsrq index 11 = -14.5 dB, rsrp index 29 = -112 dBm. Not in the Type 1SC
# manual's command list: a bench check.
SYNTHETIC | AT+CESQ
SYNTHETIC | +CESQ: 99,99,255,255,11,29,255,255,255
SYNTHETIC | OK
# %CEER module/procedure/failure strings are NOT documented: invented here.
SYNTHETIC | AT%CEER?
SYNTHETIC | %CEER: 0,"EMM","ATTACH","REJECT",15,"No Suitable Cells In tracking area"
SYNTHETIC | OK
# EF_FPLMN: 001-01 and 001-001 (test PLMNs), two empty slots.
SYNTHETIC | AT+CRSM=176,28539,0,0,12
SYNTHETIC | +CRSM: 144,0,"00F110001100FFFFFFFFFFFF"
SYNTHETIC | OK
expect-text | REGISTRATION DENIED x3 | EMM #15 No suitable cells in tracking area | LTE-M B20 RSRP -112 dBm RSRQ -14.5 dB | TAC 1A2B CI 01A2B3C | PSM req 3600/60 s, granted - | eDRX req 81.92 s, granted 20.48 s | FPLMN 001-01 001-001 | fw 0.3.1 | 3.61 V | uptime 4h12m
expect-counts | unknown=0 malformed=0 too_long=0

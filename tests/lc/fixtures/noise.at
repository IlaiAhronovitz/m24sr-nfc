# noise.at - lines the parser must survive: unknown, malformed, over-long,
# refused SIM reads. Nothing here may change the record.
# Format: see denied_15.at.
@ 7
SYNTHETIC | RDY
SYNTHETIC | +CGEV: ME PDN ACT 1
SYNTHETIC | +CEREG: 9,"zz"
SYNTHETIC | +CEREG: 5,3,"1A2B","01A2B3C",7,0,99999
SYNTHETIC | +CESQ: 99,99
SYNTHETIC | +CEREG: 5,3,"1A2B
# A 304-byte line: dropped and counted.
SYNTHETIC | +CEREG: 5,3,"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
# +CRSM with no FPLMN read pending: ignored.
SYNTHETIC | +CRSM: 144,0,"00F110"
SYNTHETIC | AT+CRSM=176,28539,0,0,12
# 6A82 = file not found: nothing learnt, the FPLMN list stays unknown.
SYNTHETIC | +CRSM: 106,130
SYNTHETIC | +CME ERROR: 10
SYNTHETIC | ERROR
SYNTHETIC | %CEER: 0
SYNTHETIC | %CEER: "RRC","CONNECTION","FAILURE",3
SYNTHETIC | %MEAS: RSRP:Reported=N/A
expect-text | NO REGISTRATION STATUS
expect-counts | unknown=2 malformed=4 too_long=1
